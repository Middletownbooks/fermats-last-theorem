{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1-retrodiction/heldout",
  "title": "Held-out answer. NEVER shown to a scored agent.",
  "type": "object",
  "required": [
    "id",
    "after_board",
    "transformation",
    "source",
    "labelled_by",
    "level"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "after_board": {
      "type": "string"
    },
    "multi_answer": {
      "type": "boolean",
      "description": "true where the rubric must accept either of two answers (case 7)"
    },
    "transformation": {
      "type": "string",
      "description": "An atom from taxonomy.label_vocabulary, a '+'-joined combination, 'none', or 'unlabelled'."
    },
    "transformation_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "labelled_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "label_pass": {
      "type": "string"
    },
    "second_blind_label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required before any label kappa exists."
    },
    "label_kappa": {
      "type": [
        "number",
        "null"
      ]
    },
    "level": {
      "type": "object",
      "required": [
        "axis",
        "confidence",
        "object_changed",
        "what_stayed_fixed",
        "basis"
      ],
      "properties": {
        "axis": {
          "enum": [
            "same-level",
            "input-level",
            "reduction-level",
            "substrate",
            "none",
            "unclear"
          ]
        },
        "confidence": {
          "type": "string"
        },
        "object_changed": {
          "type": "string"
        },
        "what_stayed_fixed": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "assigned_by": {
          "type": "string"
        },
        "recorded_for": {
          "type": "string"
        }
      },
      "description": "WHERE in the stack the change happened. An AXIS, not a transformation: D30 asked for the level and forbade a sixth transformation. Vocabulary and status in p3-taxonomy/taxonomy.json -> level_axis. Assigned by tools/assign_levels.py."
    }
  }
}
