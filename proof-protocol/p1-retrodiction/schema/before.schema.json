{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p1-retrodiction/before",
  "title": "Before-board (agent-visible half)",
  "type": "object",
  "required": ["id", "problem", "role", "supersede", "before_board", "bound_then", "leak",
               "sources_before", "encoder", "encoding_pass"],
  "not": {
    "anyOf": [
      {"required": ["after_board"]}, {"required": ["transformation"]}, {"required": ["source"]}
    ]
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
    "problem": {"type": "string"},
    "role": {"const": "positive"},
    "flag": {"type": ["string", "null"],
             "description": "fit-testing-only marks an item that must not be scored as a prediction"},
    "supersede": {
      "type": "object", "required": ["paper", "date"],
      "properties": {"paper": {"type": "string"}, "ref": {"type": "string"},
                     "date": {"type": "string"}},
      "description": "The paper that changed the board. No source may be dated at or after this."
    },
    "before_board": {
      "type": "object",
      "properties": {
        "S": {"type": ["string", "null"], "description": "state"},
        "M": {"type": ["string", "null"], "description": "move"},
        "I": {"type": ["string", "null"], "description": "invariant"},
        "C": {"type": ["string", "null"], "description": "composition"},
        "T": {"type": ["string", "null"], "description": "terminal certificate"}
      },
      "additionalProperties": false
    },
    "bound_then": {"type": "string"},
    "leak": {"type": "string", "description": "Where the board loses the truth."},
    "sources_before": {
      "type": "array",
      "items": {"type": "object", "required": ["cite", "date", "verified"],
                "properties": {"cite": {"type": "string"}, "date": {"type": "string"},
                               "verified": {"type": "boolean"}, "debt": {"type": "string"}}}
    },
    "encoder": {"type": "string"},
    "encoding_pass": {"type": "string"},
    "blind_reencoding": {
      "type": "object",
      "properties": {"done": {"type": "boolean"}, "encoder": {"type": ["string", "null"]},
                     "kappa": {"type": ["number", "null"]}}
    }
  }
}
